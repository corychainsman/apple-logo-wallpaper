<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cchainsm.apple-logo-wallpaper-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/cchainsm/Documents/Dev/Apple Logos Wallpaper/server.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Users/cchainsm/Library/Logs/apple-logo-wallpaper-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cchainsm/Library/Logs/apple-logo-wallpaper-server-error.log</string>
</dict>
</plist>
